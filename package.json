{
  "name": "glucoapp",
  "version": "0.1.0",
  "private": true,
  "description": "GlucoApp — suivi glycémique, composition de repas et rituel du thé régulateur.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
